/* House theme for the easy-db-lab lab report.  book.toml loads it through additional-css.
   Badge colours are Okabe-Ito, the colour-blind-safe palette that lab.mplstyle also uses. */

:root {
  --content-max-width: 1100px;
}

/* mdbook wraps each table in .table-wrapper.  A bounded wrapper scrolls on its own, so the
   sticky header stays in view on a long stats table. */
.content .table-wrapper {
  max-height: 75vh;
  overflow: auto;
}

.content table {
  font-variant-numeric: tabular-nums;
}

/* The whole thead sticks, so mdbook's collapsed thead row border sticks with it. */
.content thead {
  position: sticky;
  top: 0;
  z-index: 1;
}

.content thead th {
  background: var(--table-header-bg);
}

.content tbody tr:nth-child(even) {
  background: var(--table-alternate-bg);
}

.verdict {
  display: inline-block;
  padding: 0.1em 0.6em;
  border-radius: 0.8em;
  font-weight: 600;
  white-space: nowrap;
}

.verdict-confirmed {
  background: #009E73;
  color: #ffffff;
}

.verdict-refuted {
  background: #D55E00;
  color: #ffffff;
}

.verdict-inconclusive {
  background: #E69F00;
  color: #000000;
}

.verdict-partial {
  background: #999999;
  color: #000000;
}

@media print {
  .content .table-wrapper {
    max-height: none;
    overflow: visible;
  }

  .content thead {
    position: static;
  }

  /* A stats table must fit the page width, so print cells are tighter and smaller. */
  .content table {
    width: 100%;
    font-size: 0.8em;
    page-break-inside: avoid;
  }

  .content table td,
  .content table th {
    padding: 2px 6px;
  }

  .content img {
    max-width: 100%;
    page-break-inside: avoid;
  }

  .verdict {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
}
