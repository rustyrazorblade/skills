# Shared matplotlib style for easy-db-lab lab report graphs.  report-graph.py plot loads it.
#
# Palette: Okabe-Ito, the colour-blind-safe palette from Okabe and Ito, "Color Universal
# Design" (2008), https://jfly.uni-koeln.de/color/.  The dataviz skill was not available, so
# the palette comes from that source.
#
# report-graph.py maps arm names to colours explicitly: baseline is grey 999999 and candidate is
# blue 0072B2.  Extra arms take the cycle below in order and skip those two colours.  A plot with
# no arm takes the cycle in order.

axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9', 'F0E442', '000000'])

font.family: sans-serif
font.size: 10
axes.titlesize: 12
axes.labelsize: 10
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
legend.frameon: False

figure.figsize: 9, 4.5
figure.dpi: 100
savefig.dpi: 150
savefig.bbox: tight
savefig.facecolor: white

axes.grid: True
grid.color: e6e6e6
grid.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False

lines.linewidth: 2
